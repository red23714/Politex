layout {
    cwd "/home/red/Documents/Politex/projects/OS/lab1"
    tab name="asm" hide_floating_panes=true {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane command="/nix/store/lpvd9jcq8k518mrafh2srw9a41cdavyd-neovim-unwrapped-0.11.6/bin/nvim" {
            args "--cmd" "lua" "vim.g.loaded_node_provider=0;vim.g.loaded_perl_provider=0;vim.g.loaded_python_provider=0;vim.g.python3_host_prog='/nix/store/a3ncnk80dqqcnv3jvhdky8ydbabwg7xp-neovim-0.11.6/bin/nvim-python3';vim.g.loaded_ruby_provider=0"
            start_suspended true
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="qemu" hide_floating_panes=true {
        pane size=1 borderless=true {
