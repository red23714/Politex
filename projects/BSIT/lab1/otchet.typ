    [`GET_FREESPACE`], [нет], [Свободное место на локальных дисках],
    [`GET_ACL`], [тип объекта (`FILE` или `REG`), путь], [Права доступа к файлу, папке или ключу реестра],
    [`GET_OWNER`], [тип объекта (`FILE` или `REG`), путь], [Владелец файла, папки или ключа реестра],
