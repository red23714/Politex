def nod(a, b):
    r0, r1 = a, b
    x0, x1 = 1, 0
    y0, y1 = 0, 1

    i = 1
    while r0 % r1 != 0:
        print(i, " : ", r1, x1, y1)
        q = r0 // r1

        x0_old = x0
        y0_old = y0
        r0_old = r0

        x0 = x1
        x1 = x0_old - q * x1

        y0 = y1
        y1 = y0_old - q * y1

        r0 = r1
        r1 = r0_old % r1

        i += 1

    return r1, x1, y1

def nod_bin(a, b):
    g = 1

    while a % 2 == 0 and b % 2 == 0:
        a = a // 2
        b = b // 2
        g = 2 * g

    u = a
    v = b
    A = 1
    B = 0
    C = 0
    D = 1

    i = 1
    while u != 0:
        while u % 2 == 0:
            u = u // 2
            if A % 2 == 0 and B % 2 == 0:
                A = A // 2
                B = B // 2
            else:
                A = (A + b) // 2
                B = (B - a) // 2

        while v % 2 == 0:
            v = v // 2

            if C % 2 == 0 and D % 2 == 0:
                C = C // 2
                D = D // 2
            else:
                C = (C + b) // 2
                D = (D - a) // 2

        if u >= v:
            u = u - v
            A = A - C
            B = B - D
            print(f"{i} : {u} {A} {B}")
        else:
            v = v - u
            C = C - A
            D = D - B
            print(f"{i} : {v} {C} {D}")

        i += 1

    d = g * v
    x = C
    y = D

    return d, x, y

def nod_min_abs(a, b):
    r0, r1 = a, b
    x0, x1 = 1, 0
    y0, y1 = 0, 1
    i = 1

    while True:
        fq = r0 // r1
        cand_low = r0 - fq * r1
        cand_high = cand_low - r1

        if abs(cand_low) < abs(cand_high):
            q, r_next = fq, cand_low
        elif abs(cand_low) > abs(cand_high):
            q, r_next = fq + 1, cand_high
        else:
            if cand_low > 0:
                q, r_next = fq, cand_low
            else:
                q, r_next = fq + 1, cand_high

        if r_next == 0:
            sign = 1 if r1 > 0 else -1
            d = sign * r1
            x = sign * x1
            y = sign * y1
            return d, x, y

        x_next = x0 - q * x1
        y_next = y0 - q * y1

        print(f"{i + 1} {r_next} {x_next} {y_next}")

        r0, r1 = r1, r_next
        x0, x1 = x1, x_next
        y0, y1 = y1, y_next
        i += 1

