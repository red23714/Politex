
#set text(
  lang: "ru",
  font: "Times New Roman",
  size: 14pt,
)

#let par-indent = 1.25cm

// основной текст
#set par(
  justify: true,
  first-line-indent: par-indent,
  leading: 0.8em,   // ~1.5 интервала
  spacing: 0.7em,
)

// заголовки
#set heading(numbering: "1.")
#show heading.where(level: 1): set text(size: 16pt)

// ⬇⬇⬇ ВОТ КЛЮЧЕВОЕ МЕСТО ⬇⬇⬇
#show heading: it => block(
  inset: (left: par-indent),
)[
  #it
]

