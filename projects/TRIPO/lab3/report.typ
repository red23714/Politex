= Приложения

== Приложение А

Скрипт расшифровки конфигурации из ресурса `SETTINGS` (`decrypt_settings.py`).

```python
import sys

def rc4(key: bytes, data: bytes) -> bytes:
    S = list(range(256)); j = 0
    for i in range(256):
        j = (j + S[i] + key[i % len(key)]) % 256
        S[i], S[j] = S[j], S[i]
    i = j = 0; out = bytearray()
    for b in data:
        i = (i + 1) % 256; j = (j + S[i]) % 256
        S[i], S[j] = S[j], S[i]
        out.append(b ^ S[(S[i] + S[j]) % 256])
    return bytes(out)

blob = open(sys.argv[1], "rb").read()
klen = blob[0]                 # первый байт - длина ключа
key = blob[1:1 + klen]         # RC4-ключ
enc = blob[1 + klen:]          # зашифрованная конфигурация
dec = rc4(key, enc)

print(f"размер ресурса: {len(blob)}, ключ: {klen}, данных: {len(enc)}")
print(repr(dec))
for n, f in enumerate(dec.split(b"@@")):
    print(n, repr(f))
```

